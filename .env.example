# GEMINI_API_KEY: Required for Google Gemini API calls.
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."

# ACCESS_PIN: Secret PIN protection for your private proxy on Render.
# Required by frontend to authenticate every request (prevents unauthorized public usage).
# Default fallback if not set: 1234
ACCESS_PIN="1234"

# PORT: Server port (automatically provided by Render or defaults to 3000)
PORT=3000
