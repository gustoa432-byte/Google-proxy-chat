# --- СЕРВЕРНЫЕ НАСТРОЙКИ (ДЛЯ ВЛАДЕЛЬЦА RENDER) ---
# Если переменные не заданы, сервер работает как публичный BYOK-шлюз:
# каждый пользователь использует собственный API-ключ, вводимый в интерфейсе.

# GEMINI_API_KEY: Ключ владельца сервера (опционально).
# Нужен только для режима владельца. Обычные пользователи вводят свой ключ в UI.
# Получить ключ: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."

# ACCESS_PIN: Административный PIN владельца (опционально, например: "4921").
# Защищает ваш серверный GEMINI_API_KEY от несанкционированного расхода квоты.
# Только пользователи с этим PIN могут тратить серверный ключ.
ACCESS_PIN="1234"

# PORT: Порт веб-сервера (Render задает автоматически).
PORT=3000
